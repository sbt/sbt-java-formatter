# Test 120-column string reflow before an earlier narrow width can split the literal.
> set ThisBuild / javafmtMaxLineLength := 120
> javafmtAll
> javafmtCheckAll
$ exec diff src/main/java/com/lightbend/LineLength.java src/main/java-expected-fresh-120/com/lightbend/LineLength.java

# Restore unsplit input before testing width changes against warm caches.
$ copy-file src/main/java-original/com/lightbend/LineLength.java src/main/java/com/lightbend/LineLength.java
> set ThisBuild / javafmtMaxLineLength := 100
> javafmtAll
> javafmtCheckAll
$ exec diff src/main/java/com/lightbend/LineLength.java src/main/java-expected-100/com/lightbend/LineLength.java

